# ews-mcp 5.0 — example configuration.
# Copy to `.env` in the directory you run `ewsmcp` from (auto-loaded),
# or put these in your MCP client's `env` block instead.
# NEVER commit a real .env.

# --- Exchange (required) -------------------------------------------------
EWS_SERVER_URL=https://mail.example.com/EWS/Exchange.asmx
EWS_EMAIL=user@example.com
EWS_USERNAME=user
EWS_PASSWORD=change-me

# --- Safety (defaults shown; already safe) --------------------------------
# read = read-only tools; draft = + drafts/labels; full = + send/delete
EWS_CAPABILITY_TIER=draft
# Global send kill-switch. Nothing sends until this is true AND tier=full.
SEND_ENABLED=false
#EWS_RECIPIENT_ALLOWLIST=*@example.com
#EWS_MAX_SENDS_PER_HOUR=10
# Set this to keep confirm tokens valid across restarts:
#SEND_CONFIRM_SECRET=generate-a-long-random-string

# --- Storage: Postgres (required by BOTH processes) --------------------------
DATABASE_URL=postgresql://ews:change-me@127.0.0.1:5432/ews
# docker-compose.yml only: password for the postgres service (composes
# DATABASE_URL for ewsd/ewsmcp itself — not read by either process directly).
#PGPASSWORD=change-me
# --- Daemon (ewsd) -----------------------------------------------------------
#EWSD_HOST=127.0.0.1
#EWSD_PORT=8790
#EWSD_API_KEY=generate-a-long-random-string   # required off-loopback; docker-compose.yml requires it uncommented
# Public base URL that reaches ewsd (e.g. https://ews.example.com). Used to
# build the absolute capability URL returned by create_upload_link — your
# reverse proxy must route /upload/* to ewsd:8790. Empty → the tool returns
# a relative /upload/<token> and the caller supplies its own origin.
#EXTERNAL_URL=
# --- MCP → daemon ------------------------------------------------------------
#EWSD_URL=http://127.0.0.1:8790

# --- Mirror (ewsd) -----------------------------------------------------------
# Every mail folder is mirrored in full. These well-known folders are not:
# (exclusion is by well-known key only — sub-folders of an excluded folder
# are still mirrored)
#EWS_MIRROR_EXCLUDE=drafts,junk,trash,outbox
#EWS_CACHE_SYNC_SECONDS=45
#EWS_CACHE_HIERARCHY_SECONDS=600

# --- Storage: local disk ONLY (cloud-synced folders are refused) ----------
# Default is ~/.ewsmcp. If your home directory is synced (OneDrive etc.),
# point this at a plain local path:
#DATA_DIR=C:\ewsmcp-data

# --- HTTP mode only (all unused over stdio) --------------------------------
#MCP_TRANSPORT=http
#MCP_HOST=127.0.0.1
#MCP_PORT=8000
#MCP_API_KEY=generate-a-long-random-string   # docker-compose.yml requires it uncommented

# --- Embeddings (daemon only; ewsmcp must never hold this key) ------------
# Semantic search stays keyword-only until this is set.
#GEMINI_API_KEY=generate-a-long-random-string
#EMBED_DIMS=768   # fixed by migration 003's vector(768) column; do not change

# --- Archive pipeline (daemon only) ----------------------------------------
# Well-known folder keys to archive; never calendar/contacts/tasks.
#ARCHIVE_FOLDERS=inbox,sent
#ARCHIVE_AFTER_DAYS=180
#ARCHIVE_EXCLUDE_CATEGORIES=
#ARCHIVE_GRACE_DAYS=7
# Deletion is OFF by default (rail 1 of 3); tier must also be full.
#ARCHIVE_DELETE_ENABLED=false
#ARCHIVE_MAX_DELETE_PER_RUN=200
#ARCHIVE_MIN_FREE_GB=2.0
#ARCHIVE_CYCLE_SECONDS=300

# --- Misc ------------------------------------------------------------------
#EWS_TZ=Asia/Riyadh
#LOG_LEVEL=INFO
